{
  "name": "lofy — DJ Visualizer",
  "short_name": "lofy",
  "id": "/",
  "lang": "en-US",
  "dir": "ltr",
  "description": "Browser-native DJ visualizer. Real-time beat-reactive visuals synced to your music in milliseconds.",
  "start_url": "./app.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0a0d",
  "theme_color": "#0a0a0d",
  "categories": ["music", "entertainment", "utilities"],
  "icons": [
    { "src": "./assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./assets/icon.svg",     "sizes": "any",      "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    {
      "src": "./assets/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "lofy Spectrum mode running in the browser"
    },
    {
      "src": "./assets/screenshot-narrow.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "lofy Particle Storm mode on mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Launch Visualizer",
      "short_name": "Launch",
      "description": "Open the lofy visualizer",
      "url": "./app.html",
      "icons": [{ "src": "./assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Home",
      "url": "./index.html"
    }
  ],
  "file_handlers": [
    {
      "action": "./app.html",
      "accept": {
        "audio/mpeg":  [".mp3"],
        "audio/wav":   [".wav"],
        "audio/ogg":   [".ogg"],
        "audio/flac":  [".flac"],
        "audio/aac":   [".aac", ".m4a"]
      },
      "icons": [{ "src": "./assets/icon-192.png", "sizes": "192x192" }],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./app.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text":  "text",
      "url":   "url"
    }
  },
  "prefer_related_applications": false
}
